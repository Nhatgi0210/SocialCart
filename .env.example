# Local template; do not put real secrets in this tracked file.
APP_ENV=local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=socialcart_db
MYSQL_USER=socialcart
MYSQL_PASSWORD=CHANGE_ME_LOCAL_ONLY
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=mysql+aiomysql://socialcart:CHANGE_ME_LOCAL_ONLY@127.0.0.1:3306/socialcart_db
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=socialcart-auth
JWT_AUDIENCE=socialcart-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_SECONDS=86400
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Required only for platform token encryption: 32 random bytes as 64 hex chars.
ENCRYPTION_KEY=
# Required for authenticated service-to-service calls; never a VITE_ variable.
INTERNAL_SERVICE_TOKEN=
SEED_SELLER_EMAIL=
SEED_SELLER_PASSWORD=
FACEBOOK_ENABLED=false
FB_APP_ID=
FB_APP_SECRET=
FB_WEBHOOK_VERIFY_TOKEN=
ZALO_ENABLED=false
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_WEBHOOK_SECRET=
AI_ENABLED=false
GEMINI_API_KEY=
# Set only after INT-01 verifies a model accessible to this project.
GEMINI_MODEL=
AUTH_SERVICE_URL=http://127.0.0.1:8001
CONVERSATION_SERVICE_URL=http://127.0.0.1:8002
CUSTOMER_SERVICE_URL=http://127.0.0.1:8003
PRODUCT_SERVICE_URL=http://127.0.0.1:8004
ORDER_SERVICE_URL=http://127.0.0.1:8005
AI_SERVICE_URL=http://127.0.0.1:8006
WEBHOOK_SERVICE_URL=http://127.0.0.1:8007
DASHBOARD_SERVICE_URL=http://127.0.0.1:8008
REALTIME_SERVICE_URL=http://127.0.0.1:8009
PLATFORM_SERVICE_URL=http://127.0.0.1:8010
VITE_API_URL=http://localhost:8000/api/v1
VITE_SOCKET_URL=http://localhost:8009
NGROK_AUTHTOKEN=
# Optional; use the domain actually assigned to your account.
NGROK_DOMAIN=
